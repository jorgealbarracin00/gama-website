  "claimReconciliations": [
    {
      "topic": "Checkout / shipping",
      "finding": "Live product page explicitly says website checkout is not yet available. Backend order and configured fixed-rate/package-fit shipping support exist. No evidence of automatic carrier postage-label purchase; treated as future direction."
    },
    {
      "topic": "Size mapping",
      "finding": "Current source uses separate 1=12\u201318m, 2=18\u201324m, 3=24\u201336m rather than the older coarse ranges in the brief. Availability uses an in-stock, purchasable variant with positive available quantity."
    },
    {
      "topic": "Quick Storage",
      "finding": "Current client is deliberate tap-to-scan, one label per request, with label-read beep, backend-accepted chime, rejected low tone. Batch destination review and confirmation perform atomic put-away with stable-operation retry."
    },
    {
      "topic": "Product / item actions",
      "finding": "Product, variant and physical allocation are separate. Publication acts on the entire product even from Item Actions. SKU labels are inventory labels, separate from postage."
    },
    {
      "topic": "AI / photos",
      "finding": "Merchant facts remain authoritative. Enrichment v3 tracks confidence/provenance and validates structured hook, summary, highlights. Eight current selectable image scenes; originalEnhanced is legacy. Human review still required for product truth."
    },
    {
      "topic": "Help Me Choose",
      "finding": "Four steps: size, recipient, moment, colour. Relaxation order is colour, moment, recipient; never size."
    },
    {
      "topic": "Authentication",
      "finding": "Registration, sign-in/out, verification, reset, persistent secure cookie, Apple/Google routes and account-state navigation found in current source. Public sign-in captured. Signed-in navigation not captured."
    },
    {
      "topic": "Failure studies",
      "finding": "01 is supported by commit 3f423d2 enrichment recovery regression, including blank subcategory. 02/03 are conceptual design pressures supported by current Find & Scan and action models, not invented historical bugs. 04 uses documented commit c2b7f8b atomic batch Put Away and current retry tests."
    }
  ],
  "evidenceLimitations": [
    "Only Catalog and Put Away native screenshots are currently available. Catalog captured from the live native app; Put Away is an authentic native verification screen with fictional inventory.",
    "Find & Scan, Item Actions, Product Actions, creation/enrichment, stock editing and labels are supported in current source but do not yet have dedicated screenshot evidence on the specimen.",
    "iPhone Mirroring repeatedly disconnected because the iPhone was in use. User availability requested once; no authenticated web session available.",
    "Coco native/backend tests inspected, not rerun as part of this website-only change. Website build, lint, TypeScript and browser checks tracked separately."
  ],
